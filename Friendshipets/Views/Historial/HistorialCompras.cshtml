@model List<Friendshipets.Models.ViewModels.cListaFacturas>
@{
    ViewBag.Title = "Historial Compras";
    Layout = "~/Views/Shared/_LayoutTienda.cshtml";
}

<main>
    <div class="container-fluid px-4">
        <ol class="breadcrumb mb-4 mt-4">
            <li class="breadcrumb-item"><a href="@Url.Action("Index","Tienda")">Inicio</a></li>
            <li class="breadcrumb-item active">Historial Compras</li>
        </ol>

        <div class="card shadow mb-4 mt-4">
            <div class="card-header py-3 bg-second-primary">
                <h6 class="m-0 font-weight-bold text-white">Tu Historial de Compras</h6>
            </div>
            <div class="card-body">
                <table class="table">
                    <thead>
                        <tr>
                            <th><div>ID Factura</div></th>
                            <th><div>ID Cliente</div></th>
                            <th><div>Fecha</div></th>
                            <th><div>Cantidad Productos</div></th>
                            <th><div>Monto Total</div></th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fila in Model)
                        {
                            <tr>
                                <td>@fila.IDFactura</td>
                                <td>@fila.IDCliente</td>
                                <td>@fila.FechaFactura</td>
                                <td>@fila.CantidadProductos</td>
                                <td>@fila.MontoTotal</td>
                                <td><input type="button" value="Consultar" class="btn btn-success" onclick="window.location.href='@Url.Content("~/Historial/ImprimirFactura/" + fila.IDFactura)'" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</main>



@section scripts{
    <script>
        $(document).ready(function () {
            $('#tabla').DataTable({
                responsive: true,
                columnDefs: [//Esto es para que la tabla no orderne los registros por la columna en la que están los botones
                    {
                        "targets": [5],
                        "orderable": false,
                        "searchable": false
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/2.2.2/i18n/es-ES.json',
                },
            });
        });
    </script>
}
